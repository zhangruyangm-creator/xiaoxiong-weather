    <string name="bear_home_dex_bf_arabtea">阿拉伯茶</string>
    <string name="bear_home_dex_bf_arabtea_detail">加了薄荷和糖的浓红茶，倒进透明小杯，香气一下子散开。</string>
    <string name="bear_home_dex_bf_bacon_eggs">培根煎蛋</string>
    <string name="bear_home_dex_bf_bacon_eggs_detail">煎到滋滋冒油的培根，配上流心煎蛋和烤面包，经典美式能量早餐。</string>
    <string name="bear_home_dex_bf_bagel">贝果</string>
    <string name="bear_home_dex_bf_bagel_detail">嚼劲十足的贝果抹上奶油奶酪，配一杯咖啡，是城市的节奏。</string>
    <string name="bear_home_dex_bf_banchan">韩式小菜</string>
    <string name="bear_home_dex_bf_banchan_detail">辣白菜、萝卜块、菠菜…一碟碟摆满桌，五颜六色的小菜是早餐的仪式感。</string>
    <string name="bear_home_dex_bf_banhmi">越南法棍</string>
    <string name="bear_home_dex_bf_banhmi_detail">酥脆的法棍夹着烤肉、香菜和腌萝卜，酸辣又清爽。</string>
    <string name="bear_home_dex_bf_baozi">包子</string>
    <string name="bear_home_dex_bf_baozi_detail">白白胖胖的肉包子冒着热气，咬开是满满的汤汁，暖手又暖胃。</string>
    <string name="bear_home_dex_bf_cereal">麦片</string>
    <string name="bear_home_dex_bf_cereal_detail">谷粒泡在牛奶里咔嚓咔嚓，加上水果片，是小朋友也爱的小快乐。</string>
    <string name="bear_home_dex_bf_changfen">肠粉</string>
    <string name="bear_home_dex_bf_changfen_detail">米浆蒸成薄透的粉皮，卷上虾仁和青菜，淋一勺豉油，嫩滑爽口。</string>
    <string name="bear_home_dex_bf_congee">白粥</string>
    <string name="bear_home_dex_bf_congee_detail">小火慢熬到米粒开花，配上咸菜和肉松，清淡又养胃。</string>
    <string name="bear_home_dex_bf_dates">椰枣</string>
    <string name="bear_home_dex_bf_dates_detail">蜜甜的椰枣是沙漠里的天然糖果，配着茶吃刚刚好。</string>
    <string name="bear_home_dex_bf_eggtoast">鸡蛋吐司</string>
    <string name="bear_home_dex_bf_eggtoast_detail">焦黄的吐司卧着溏心蛋，用叉子轻轻一戳，蛋黄流到面包上。</string>
    <string name="bear_home_dex_bf_english">英式早餐</string>
    <string name="bear_home_dex_bf_english_detail">煎蛋、香肠、培根、烤番茄和焗豆摆满一盘，丰盛得像一场仪式。</string>
    <string name="bear_home_dex_bf_falafel">炸鹰嘴豆丸</string>
    <string name="bear_home_dex_bf_falafel_detail">金黄色的鹰嘴豆丸子，外脆里嫩，蘸着芝麻酱吃，是街头的人气小吃。</string>
    <string name="bear_home_dex_bf_frenchtoast">法式吐司</string>
    <string name="bear_home_dex_bf_frenchtoast_detail">吐司吸饱蛋奶液煎到两面金黄，撒上糖粉，外脆内软像布丁。</string>
    <string name="bear_home_dex_bf_gyeranbap">鸡蛋拌饭</string>
    <string name="bear_home_dex_bf_gyeranbap_detail">热腾腾的米饭打上生蛋黄，浇一勺香油拌开，简单却让人停不下嘴。</string>
    <string name="bear_home_dex_bf_hummus">鹰嘴豆泥</string>
    <string name="bear_home_dex_bf_hummus_detail">绵密的鹰嘴豆泥淋上橄榄油，用热乎乎的皮塔饼蘸着吃，又香又顶饱。</string>
    <string name="bear_home_dex_bf_jianbing">煎饼果子</string>
    <string name="bear_home_dex_bf_jianbing_detail">摊得薄薄的绿豆面饼，打上鸡蛋刷上酱，夹根脆油条，边走边吃最有烟火气。</string>
    <string name="bear_home_dex_bf_juk">韩式粥</string>
    <string name="bear_home_dex_bf_juk_detail">白粥熬得又稠又糯，撒上海苔碎和芝麻，滴几滴香油，暖到心底。</string>
    <string name="bear_home_dex_bf_kayatoast">咖椰吐司</string>
    <string name="bear_home_dex_bf_kayatoast_detail">烤得脆脆的吐司夹着绿色咖椰酱和黄油片，配一杯南洋咖啡，甜甜的早晨。</string>
    <string name="bear_home_dex_bf_kimbap">紫菜包饭</string>
    <string name="bear_home_dex_bf_kimbap_detail">海苔卷着米饭、蛋丝、胡萝卜和火腿，切成一圈圈，是野餐必备的便携美味。</string>
    <string name="bear_home_dex_bf_koreantoast">韩式吐司</string>
    <string name="bear_home_dex_bf_koreantoast_detail">厚厚的吐司夹着煎蛋和卷心菜丝，抹一层甜辣酱，纸袋一包，街上最香的早餐。</string>
    <string name="bear_home_dex_bf_manakish">马纳基什</string>
    <string name="bear_home_dex_bf_manakish_detail">撒满芝麻和香草的面饼烤得边角焦脆，卷起来就是一份边走边吃的早餐。</string>
    <string name="bear_home_dex_bf_milkbread">牛奶面包</string>
    <string name="bear_home_dex_bf_milkbread_detail">松软拉丝的牛奶面包，配上一杯热牛奶，简单又治愈。</string>
    <string name="bear_home_dex_bf_nasilemak">椰浆饭</string>
    <string name="bear_home_dex_bf_nasilemak_detail">椰香扑鼻的米饭配上炸花生小鱼和参巴酱，是热带清晨的打开方式。</string>
    <string name="bear_home_dex_bf_noodles">汤面</string>
    <string name="bear_home_dex_bf_noodles_detail">清汤小面卧个荷包蛋，撒一把葱花，呼噜呼噜就是一碗落胃的面。</string>
    <string name="bear_home_dex_bf_oatmeal">燕麦粥</string>
    <string name="bear_home_dex_bf_oatmeal_detail">牛奶煮燕麦，撒上蓝莓和坚果碎，温温柔柔的元气早餐。</string>
    <string name="bear_home_dex_bf_omelette">欧姆蛋</string>
    <string name="bear_home_dex_bf_omelette_detail">蓬松的蛋卷里裹着芝士和彩椒，用刀切开，热气腾腾。</string>
    <string name="bear_home_dex_bf_pho">越南河粉</string>
    <string name="bear_home_dex_bf_pho_detail">清澈的牛骨汤烫着软滑河粉和薄牛肉片，挤上青柠，鲜到眉毛掉下来。</string>
    <string name="bear_home_dex_bf_roticanai">印度煎饼</string>
    <string name="bear_home_dex_bf_roticanai_detail">层层酥脆的煎饼蘸着咖喱汁，用手撕着吃，面香四溢。</string>
    <string name="bear_home_dex_bf_sandwich">三明治</string>
    <string name="bear_home_dex_bf_sandwich_detail">面包夹着火腿、生菜和煎蛋，层层叠叠，赶时间也能好好吃早餐。</string>
    <string name="bear_home_dex_bf_shakshuka">北非蛋</string>
    <string name="bear_home_dex_bf_shakshuka_detail">番茄酱汁咕嘟咕嘟煮着溏心蛋，用面包蘸着汤汁，酸甜开胃。</string>
    <string name="bear_home_dex_bf_waffle">华夫饼</string>
    <string name="bear_home_dex_bf_waffle_detail">烤得焦香的格子华夫，淋上枫糖浆堆满莓果，甜滋滋开启一天。</string>
    <string name="bear_home_dex_bf_youtiao">油条</string>
    <string name="bear_home_dex_bf_youtiao_detail">刚出锅的油条金黄酥脆，配上一碗热豆浆，咔嚓一声，是清晨最满足的声音。</string>
    <string name="bear_home_dex_di_banhxeo">越南煎饼</string>
    <string name="bear_home_dex_di_banhxeo_detail">金黄酥脆的米饼里包着豆芽和虾肉，蘸鱼露用生菜一卷，咔嚓一声。</string>
    <string name="bear_home_dex_di_bbq">烧烤</string>
    <string name="bear_home_dex_di_bbq_detail">炭火上的烤架滋滋作响，肉香混着烟火气，是夏夜的快乐。</string>
    <string name="bear_home_dex_di_budaejjigae">部队锅</string>
    <string name="bear_home_dex_di_budaejjigae_detail">午餐肉、香肠、泡面加芝士一锅乱炖，越煮越香，是深夜的狂欢。</string>
    <string name="bear_home_dex_di_chimaek">炸鸡啤酒</string>
    <string name="bear_home_dex_di_chimaek_detail">金黄酥脆的炸鸡配冰镇啤酒，是韩剧里的快乐公式。</string>
    <string name="bear_home_dex_di_couscous">古斯古斯</string>
    <string name="bear_home_dex_di_couscous_detail">松软的蒸粗麦粉配上炖菜和肉汁，北非的家常味道。</string>
    <string name="bear_home_dex_di_galbi">烤排骨</string>
    <string name="bear_home_dex_di_galbi_detail">甜咸入味的烤排骨烤到焦香，用生菜包着吃，肉汁在嘴里爆开。</string>
    <string name="bear_home_dex_di_hainanese">海南鸡饭</string>
    <string name="bear_home_dex_di_hainanese_detail">滑嫩的白切鸡配鸡油饭，蘸着姜蓉酱，简单却让人念念不忘。</string>
    <string name="bear_home_dex_di_hotpot">火锅</string>
    <string name="bear_home_dex_di_hotpot_detail">咕嘟咕嘟的红油锅底，涮肉涮菜涮到停不下来，是围炉的快乐。</string>
    <string name="bear_home_dex_di_italian">意式晚餐</string>
    <string name="bear_home_dex_di_italian_detail">前菜、意面、甜点一道道慢慢上，是悠闲的南欧夜色。</string>
    <string name="bear_home_dex_di_jajangmyeon">炸酱面</string>
    <string name="bear_home_dex_di_jajangmyeon_detail">浓稠的春酱裹着面条，洋葱和肉丁入味，呼噜呼噜拌着吃。</string>
    <string name="bear_home_dex_di_kebab">烤肉串</string>
    <string name="bear_home_dex_di_kebab_detail">大块烤肉串在炭火上烤到微焦，配洋葱和酸奶酱，豪爽又过瘾。</string>
    <string name="bear_home_dex_di_laksa">叻沙</string>
    <string name="bear_home_dex_di_laksa_detail">椰浆咖喱汤头配米粉，虾和鱼饼堆得满满，浓郁又上头。</string>
    <string name="bear_home_dex_di_lau">老挝火锅</string>
    <string name="bear_home_dex_di_lau_detail">一圈烤盘边涮边烤，肉菜两面煎香，围着一圈热热闹闹。</string>
    <string name="bear_home_dex_di_mansaf">曼萨夫</string>
    <string name="bear_home_dex_di_mansaf_detail">藏红花米饭铺着炖羊肉，浇上酸奶酱，是待客的大菜。</string>
    <string name="bear_home_dex_di_massaman">玛莎曼咖喱</string>
    <string name="bear_home_dex_di_massaman_detail">微甜的咖喱炖牛肉，配土豆和花生，柔和不辣却很香。</string>
    <string name="bear_home_dex_di_mezze">中东拼盘</string>
    <string name="bear_home_dex_di_mezze_detail">各色小菜摆满一桌，蘸酱配饼，边聊边吃。</string>
    <string name="bear_home_dex_di_pizza">披萨</string>
    <string name="bear_home_dex_di_pizza_detail">芝士拉出长长的丝，饼边烤得焦脆，一块接一块停不下来。</string>
    <string name="bear_home_dex_di_shabu">涮涮锅</string>
    <string name="bear_home_dex_di_shabu_detail">清汤锅底涮着薄薄的肉片和蔬菜，蘸上芝麻酱，温暖又清淡。</string>
    <string name="bear_home_dex_di_shawarma">沙威玛</string>
    <string name="bear_home_dex_di_shawarma_detail">旋转烤肉卷着生菜和蒜酱，肉香浓郁，越吃越香。</string>
    <string name="bear_home_dex_di_soondubu">嫩豆腐锅</string>
    <string name="bear_home_dex_di_soondubu_detail">滚烫的嫩豆腐汤，豆腐滑嫩入口即化，打个鸡蛋更鲜。</string>
    <string name="bear_home_dex_di_spaghetti">意大利面</string>
    <string name="bear_home_dex_di_spaghetti_detail">番茄肉酱挂满每一根面条，卷起来送进嘴里，浓郁又满足。</string>
    <string name="bear_home_dex_di_steak">牛排</string>
    <string name="bear_home_dex_di_steak_detail">铁板上的牛排滋滋作响，切开是漂亮的粉红色，配红酒刚刚好。</string>
    <string name="bear_home_dex_di_sushi">寿司拼盘</string>
    <string name="bear_home_dex_di_sushi_detail">丰盛的海鲜寿司拼盘，鱼生的鲜甜在嘴里化开。</string>
    <string name="bear_home_dex_di_tagine">塔吉锅</string>
    <string name="bear_home_dex_di_tagine_detail">圆锥盖下慢炖的羊肉和蔬菜，香料味完全渗进去，一打开锅盖香气扑面。</string>
    <string name="bear_home_dex_di_teishoku">日式定食</string>
    <string name="bear_home_dex_di_teishoku_detail">米饭、味噌汤、主菜和小菜分格摆好，一人食也仪式感满满。</string>
    <string name="bear_home_dex_di_yakitori">烧鸟</string>
    <string name="bear_home_dex_di_yakitori_detail">炭火烤的鸡肉串刷上酱汁，一串串配着啤酒，深夜食堂的标配。</string>
    <string name="bear_home_dex_lu_bento">便当盒</string>
    <string name="bear_home_dex_lu_bento_detail">米饭、主菜、配菜一格一格摆得整整齐齐，打开盖子像拆一份小礼物。</string>
    <string name="bear_home_dex_lu_bibimbap">石锅拌饭</string>
    <string name="bear_home_dex_lu_bibimbap_detail">石锅烧得滋滋响，把蛋液、辣酱和配菜拌进饭里，锅巴最香。</string>
    <string name="bear_home_dex_lu_burger">汉堡</string>
    <string name="bear_home_dex_lu_burger_detail">松软的面包夹着多汁的牛肉饼、芝士和生菜，一口咬下超满足。</string>
    <string name="bear_home_dex_lu_burgerfries">汉堡薯条</string>
    <string name="bear_home_dex_lu_burgerfries_detail">汉堡配现炸薯条，蘸着番茄酱，是经典的双倍快乐。</string>
    <string name="bear_home_dex_lu_falafel">炸鹰嘴豆丸</string>
    <string name="bear_home_dex_lu_falafel_detail">金黄的鹰嘴豆丸子配上沙拉和芝麻酱，卷进皮塔饼里，素食也有滋有味。</string>
    <string name="bear_home_dex_lu_fattoush">法图什沙拉</string>
    <string name="bear_home_dex_lu_fattoush_detail">脆脆的烤饼碎拌进番茄黄瓜和酸汁里，清爽又开胃。</string>
    <string name="bear_home_dex_lu_friedrice">炒饭</string>
    <string name="bear_home_dex_lu_friedrice_detail">粒粒分明的米饭大火翻炒，蛋香锅气十足，是治愈的家的味道。</string>
    <string name="bear_home_dex_lu_greencurry">绿咖喱</string>
    <string name="bear_home_dex_lu_greencurry_detail">椰奶绿咖喱香浓顺滑，配米饭或法棍，微辣又温柔。</string>
    <string name="bear_home_dex_lu_jiaozi">饺子</string>
    <string name="bear_home_dex_lu_jiaozi_detail">白白胖胖的饺子皮薄馅大，蘸上醋和辣油，一口一个。</string>
    <string name="bear_home_dex_lu_kabsa">卡布萨</string>
    <string name="bear_home_dex_lu_kabsa_detail">藏红花米饭配大块烤肉，香料的味道渗进每一粒米，是待客的硬菜。</string>
    <string name="bear_home_dex_lu_kbbq">韩式烤肉</string>
    <string name="bear_home_dex_lu_kbbq_detail">烤盘上五花肉滋滋冒油，用生菜包着蘸酱吃，肉香四溢。</string>
    <string name="bear_home_dex_lu_kebab">烤肉串</string>
    <string name="bear_home_dex_lu_kebab_detail">炭火烤的肉串滋滋冒油，撒上孜然和辣椒面，一串接一串。</string>
    <string name="bear_home_dex_lu_kimchijjigae">泡菜汤</string>
    <string name="bear_home_dex_lu_kimchijjigae_detail">酸辣的泡菜汤咕嘟咕嘟，配一碗热米饭，简单又开胃。</string>
    <string name="bear_home_dex_lu_mezze">中东拼盘</string>
    <string name="bear_home_dex_lu_mezze_detail">鹰嘴豆泥、茄子酱、橄榄和皮塔饼摆满一桌，分享着吃才热闹。</string>
    <string name="bear_home_dex_lu_nasigoreng">印尼炒饭</string>
    <string name="bear_home_dex_lu_nasigoreng_detail">锅气十足的炒饭配煎蛋和虾片，撒上炸葱，香到隔壁桌都馋。</string>
    <string name="bear_home_dex_lu_padthai">泰式炒河粉</string>
    <string name="bear_home_dex_lu_padthai_detail">河粉炒得油亮，挤上青柠拌进花生碎，酸甜咸鲜在嘴里开会。</string>
    <string name="bear_home_dex_lu_picnic">野餐</string>
    <string name="bear_home_dex_lu_picnic_detail">阳光草地，三明治、水果和气泡水铺开在格子布上，午餐要吃得像度假。</string>
    <string name="bear_home_dex_lu_pokebowl">波奇碗</string>
    <string name="bear_home_dex_lu_pokebowl_detail">糙米饭铺满三文鱼、牛油果和玉米粒，淋上酱汁，健康又清爽。</string>
    <string name="bear_home_dex_lu_ramen">拉面</string>
    <string name="bear_home_dex_lu_ramen_detail">浓郁的汤头配弹牙的面条，卧一枚溏心蛋，呼噜呼噜一大碗。</string>
    <string name="bear_home_dex_lu_ramyeon">韩式拉面</string>
    <string name="bear_home_dex_lu_ramyeon_detail">面条吸饱了辣汤，加片芝士打个蛋，深夜的治愈首选。</string>
    <string name="bear_home_dex_lu_satay">沙爹</string>
    <string name="bear_home_dex_lu_satay_detail">烤肉串刷满花生酱料，甜咸交织，配黄瓜块吃刚刚好。</string>
    <string name="bear_home_dex_lu_shawarma">沙威玛</string>
    <string name="bear_home_dex_lu_shawarma_detail">旋转烤肉一片片削下来，卷进饼里配蒜酱和酸黄瓜，香气扑鼻。</string>
    <string name="bear_home_dex_lu_sushi">寿司</string>
