    <string name="bear_home_dex_lu_takeout">外卖</string>
    <string name="bear_home_dex_lu_takeout_detail">工作日的救星，热腾腾的外卖盒子一打开，香气就飘满整个工位。</string>
    <string name="bear_home_dex_lu_tomyum">冬阴功</string>
